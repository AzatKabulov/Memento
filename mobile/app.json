{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "scheme": "memento",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.azatkabulov.memento"
    },
    "android": {
      "package": "com.azatkabulov.memento",
      "adaptiveIcon": {
        "backgroundColor": "#4B3026",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single",
      "name": "Memento — Daily Photo Diary",
      "shortName": "Memento",
      "themeColor": "#4B3026",
      "backgroundColor": "#4B3026",
      "description": "A private visual diary for the moments that make up your life."
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memento to capture today's moment.",
          "microphonePermission": "Allow Memento to record sound with today's video.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memento to add a moment from your photo library.",
          "cameraPermission": "Allow Memento to capture today's moment.",
          "microphonePermission": "Allow Memento to record sound with today's video."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4B3026",
          "image": "./assets/splash-mark.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#4B3026",
            "image": "./assets/splash-mark.png"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e27b8de-c18e-4bdb-adf4-f0b5af751a6b"
      }
    },
    "owner": "azatkabulov"
  }
}
